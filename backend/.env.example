# ── Local ─────────────────────────────────────────────────────────────────────
PORT=4000
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/linkchat
MONGO_DB_NAME=linkchat
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=genera_un_secreto_largo_y_aleatorio

# ── Produccion (Heroku Config Vars) ───────────────────────────────────────────
# Heroku asigna PORT automaticamente. No lo configures manualmente.
# MONGO_URI=              # o MONGODB_URI si usas addon Atlas en Heroku
# MONGO_DB_NAME=linkchat
# CLIENT_URLS=https://linkchat-lovat.vercel.app,http://localhost:5173
# CLIENT_URL_SUFFIXES=.vercel.app
# NODE_ENV=production
# JWT_SECRET=

# ── AWS (avatars S3 + Chime SDK) ──────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=nombre-de-tu-bucket-s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Chime Lambda (opcional, solo si CHIME_USE_LAMBDA=true) ──────────────────────
# URL de API Gateway donde desplegaste backend/aws/servidor-voz-chime.lambda.js
CHIME_VOICE_API_URL=https://tu-api-id.execute-api.us-east-1.amazonaws.com/default/servidor-voz-chime
# CHIME_USE_LAMBDA=true
